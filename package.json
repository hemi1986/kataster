{
  "name": "kataster",
  "version": "0.3.0",
  "description": "Agent workflow for domain-driven discovery and delivery – drop it into a greenfield or brownfield repository and build the domain by grilling.",
  "keywords": [
    "agents",
    "opencode",
    "claude-code",
    "domain-driven-design",
    "ddd",
    "domain-model",
    "event-storming",
    "workflow",
    "scaffold"
  ],
  "license": "MIT",
  "author": "Michael Schempp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemi1986/kataster.git"
  },
  "homepage": "https://github.com/hemi1986/kataster#readme",
  "bugs": {
    "url": "https://github.com/hemi1986/kataster/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "kataster": "./bin/kataster.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/install.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "guide",
    ".claude",
    ".opencode",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:install": "node --test test/install.test.mjs",
    "doctor": "node bin/kataster.mjs doctor .",
    "prepublishOnly": "npm test"
  }
}
