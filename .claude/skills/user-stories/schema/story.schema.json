{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story frontmatter (docs/stories/ST-NNN-*.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "priority", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^ST-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "type": { "enum": ["domain", "chore", "task", "tech-task", "spike", "story"] },
    "context": { "type": "string", "pattern": "^BC-[A-Za-z0-9]+$" },
    "aggregate": { "type": "string", "pattern": "^AGG-[A-Za-z0-9]+$" },
    "command": { "type": "string", "pattern": "^CMD-[A-Za-z0-9]+$" },
    "ui": { "type": "boolean" },
    "priority": { "enum": ["must", "should", "could", "wont"] },
    "size": { "enum": ["XS", "S", "M", "L", "XL", null] },
    "risk": { "enum": ["low", "medium", "high", null] },
    "events": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^EVT-[A-Za-z0-9]+$" }
    },
    "sources": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "depends_on": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ST-[0-9]{3,}$" }
    },
    "labels": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$" }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "key"],
      "properties": {
        "provider": { "enum": ["github", "jira"] },
        "key": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "status": { "enum": ["draft", "review", "ready-for-human-review", "ready", "in-progress", "done", "superseded"] }
  }
}
