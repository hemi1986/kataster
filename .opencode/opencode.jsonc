{
  "$schema": "https://opencode.ai/config.json",

  // The workflow itself lives in .claude/ and is shared with Claude Code.
  // .opencode/ holds the OpenCode wiring: agents, commands, the hook adapter plugin.
  //
  // Permissions: the hard blocks (force push, production deploy, destructive database
  // commands, generated files, accepted ADRs) are enforced by
  // .opencode/plugins/kataster/index.ts, which runs the .claude/hooks/*.ts scripts.
  // Per-agent write scopes are expressed as `edit` permissions in .opencode/agents/*.md.
  //
  // `permissions` mirrors Claude Code's `permissions.allow` (ALLOW in the installer): the workflow scripts and the
  // git/gh commands Claude Code allows run without a prompt. The last matching rule wins, so your own rules belong
  // after these. An upgrade never loosens what you restrict: a missing rule goes in front of your `deny` (and, for
  // anything but Kataster's own scripts, your `ask`), or is left out when that rule is in another config file;
  // `npx kataster doctor` says what does not work then.

  // Automations run a prompt, a Code Mode script or a shell command later, on a timer or an event – outside the
  // session's permissions and after it ended. In a marathon test run an agent whose shell commands were denied went
  // looking for another way and found `automation.create`. Off by default; a project that wants them sets `true`
  // (an upgrade keeps a value the project set).
  "automations": false,

  "permissions": [
    { "action": "shell", "resource": "node .claude/skills/event-storming/scripts/validate-events.ts", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/event-storming/scripts/render-event-storming.ts", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/user-stories/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/research/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/adopt/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/backlog/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/implement/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/metrics/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node .claude/skills/marathon/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue *", "effect": "allow" },
    { "action": "shell", "resource": "gh label *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" }
  ],

  "watcher": {
    "ignore": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/coverage/**"]
  }
}
